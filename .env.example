# Copy to .env and fill in. .env is gitignored — never commit it.

# --- secrets ---
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=http://127.0.0.1:54321
# From `npx supabase status -o env`: use SERVICE_ROLE_KEY (or SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=
# Needed from Phase 2 (job search)
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- models ---
MODEL_SCORING=claude-haiku-4-5-20251001
MODEL_TAILORING=claude-sonnet-5-5

# --- volume & quality ---
DAILY_APPLICATION_CAP=25
FIT_SCORE_THRESHOLD=70
BATCH_MIN_JOBS=20
MAX_JOB_AGE_DAYS=21
MAX_ATTEMPTS=3

# --- runtime ---
CLAUDE_CONCURRENCY=4
FILL_CONCURRENCY=2
HEADLESS=true
SUBMIT_MODE=assist
